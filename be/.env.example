PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/fitjourney
APP_ORIGIN=http://localhost:5000
# Explicit extra development origins; ignored in production.
DEV_APP_ORIGINS=http://localhost:5001
NODE_ENV=development
# Required for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FitJourney <hello@example.com>
# Set before seeding to create the first admin (minimum 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
